---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Strings & Heart — Indie Christian Rock. Three brothers from Tucson, Arizona." />
    <title>{title}</title>
    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="preload" as="video" href="/video/hero.mp4" />
  </head>
  <body>
    <!-- Grain Overlay -->
    <svg class="grain" xmlns="http://www.w3.org/2000/svg">
      <filter id="grain-filter">
        <feTurbulence type="fractalNoise" baseFrequency="0.75" numOctaves="4" stitchTiles="stitch" />
        <feColorMatrix type="saturate" values="0" />
      </filter>
      <rect width="100%" height="100%" filter="url(#grain-filter)" />
    </svg>

    <!-- Custom Cursor -->
    <div class="cursor" id="cursor"></div>

    <!-- Setlist Nav -->
    <nav class="setlist" id="setlist">
      <div class="setlist__mark" data-section="hero"></div>
      <div class="setlist__mark" data-section="about"></div>
      <div class="setlist__mark" data-section="tour"></div>
      <div class="setlist__mark" data-section="music"></div>
      <div class="setlist__mark" data-section="merch"></div>
      <div class="setlist__mark" data-section="newsletter"></div>
      <div class="setlist__mark" data-section="colophon"></div>
    </nav>

    <slot />

    <style is:global>
      @import '../styles/global.css';
    </style>

    <!-- Lenis Smooth Scroll -->
    <script is:inline src="https://unpkg.com/lenis@1.1.18/dist/lenis.min.js"></script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        var lenis = new Lenis({
          duration: 1.4,
          easing: function(t) { return 1 - Math.pow(2, -10 * t); },
          smooth: true,
        });

        lenis.stop();

        function raf(time) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        window.__lenis = lenis;

        // Custom Cursor
        var cursor = document.getElementById('cursor');
        var cx = 0, cy = 0, tx = 0, ty = 0;

        document.addEventListener('mousemove', function(e) {
          tx = e.clientX;
          ty = e.clientY;
        });

        function animateCursor() {
          cx += (tx - cx) * 0.12;
          cy += (ty - cy) * 0.12;
          if (cursor) {
            cursor.style.transform = 'translate(' + (cx - 40) + 'px, ' + (cy - 40) + 'px)';
          }
          requestAnimationFrame(animateCursor);
        }
        animateCursor();

        // Cursor link detection
        document.querySelectorAll('a, button, [data-hover]').forEach(function(el) {
          el.addEventListener('mouseenter', function() { cursor && cursor.classList.add('is-link'); });
          el.addEventListener('mouseleave', function() { cursor && cursor.classList.remove('is-link'); });
        });

        // Setlist Nav (IntersectionObserver)
        var setlist = document.getElementById('setlist');
        var sections = document.querySelectorAll('[data-section]');
        var marks = document.querySelectorAll('.setlist__mark');

        var observer = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            if (entry.isIntersecting) {
              var id = entry.target.dataset.section;
              marks.forEach(function(m) {
                m.classList.toggle('is-active', m.dataset.section === id);
              });
            }
          });
        }, { threshold: 0.3 });

        sections.forEach(function(s) { observer.observe(s); });

        // Reveal animations
        var reveals = document.querySelectorAll('.reveal, .about__member, .tour__date, .music__album');
        var revealObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry, i) {
            if (entry.isIntersecting) {
              setTimeout(function() {
                entry.target.classList.add('is-visible');
              }, i * 80);
              revealObserver.unobserve(entry.target);
            }
          });
        }, { threshold: 0.15 });

        reveals.forEach(function(r) { revealObserver.observe(r); });

        // Loader logic
        var loader = document.querySelector('.loader');
        var loaderCount = document.querySelector('.loader__count');
        var loaderLine = document.querySelector('.loader__line');
        var video = document.querySelector('.hero__video');
        var heroTitle = document.querySelector('.hero__title');

        var videoReady = false;
        var count = 0;
        var maxDuration = 4000;
        var forceCompleteTimeout = 6000;
        var startTime = Date.now();
        var forceCompleteTimer = null;

        if (video) {
          video.addEventListener('canplaythrough', function() {
            videoReady = true;
          });
          video.addEventListener('loadeddata', function() {
            setTimeout(function() { videoReady = true; }, 300);
          });
        }

        // Safety timeout: force completion even if video never loads
        forceCompleteTimer = setTimeout(function() {
          videoReady = true;
        }, forceCompleteTimeout);

        function tickLoader() {
          var elapsed = Date.now() - startTime;
          var progress = Math.min(elapsed / maxDuration, 1);

          if (videoReady && count < 100) {
            count = Math.min(count + 4, 100);
          } else {
            var target = Math.floor(progress * 92);
            if (count < target) count++;
          }

          if (loaderCount) loaderCount.textContent = String(count).padStart(2, '0');
          if (loaderLine) loaderLine.style.width = (count * 1.8) + 'px';

          if (count >= 100) {
            clearTimeout(forceCompleteTimer);
            setTimeout(function() {
              loader && loader.classList.add('is-done');
              video && video.classList.add('is-ready');
              window.__lenis && window.__lenis.start();
              setlist && setlist.classList.add('is-visible');
              setTimeout(function() {
                heroTitle && heroTitle.classList.add('is-filled');
              }, 600);
            }, 200);
            return;
          }

          requestAnimationFrame(tickLoader);
        }

        tickLoader();
      });
    </script>
  </body>
</html>
